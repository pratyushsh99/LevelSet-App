# Copy this file to .env.local for local development, and add the same
# values as Environment Variables in the Vercel project settings.

# Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Project Settings -> API -> service_role secret.
# NEVER prefix this with NEXT_PUBLIC_ and never ship it to the browser --
# it bypasses Row Level Security and must only be read by API routes
# running on the server (Vercel serverless functions).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
